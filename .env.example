# Copy to .env and fill in before running docker-compose up.

# A long random string - generate with e.g. `openssl rand -base64 32`.
# Keeping this secret safe IS the whole-database encryption; losing it
# means losing access to everything encrypted with it.
CALCLEANER_DB_KEY=

# The externally-visible HTTPS URL this instance is reachable at - gets
# embedded in every generated /feed/{token}.ics link, so it must be the
# real public URL your reverse proxy serves, never localhost and never the
# app's own http://host:8080.
CALENDARSYNC_BASE_URL=https://calendar.example.com

# Which host interface the container's port 8080 is published on. Defaults to
# 127.0.0.1, which only a proxy on THIS machine (or one reached through an
# SSH/WireGuard tunnel) can use. For a reverse proxy on another machine, set
# this to the private address that machine connects to, e.g. 10.0.0.7.
#
# Deliberately not 0.0.0.0: a bare bind listens on every interface including any
# public one, which would put an unencrypted login form on the internet.
CALENDARSYNC_BIND_ADDRESS=127.0.0.1

# Which source addresses may set X-Forwarded-For / X-Forwarded-Proto, as a
# comma-separated list of CIDRs. The app speaks plain HTTP on 8080 and trusts
# a reverse proxy to tell it the real client IP and scheme; this is the list of
# who is allowed to do that telling.
#
# It is a security control, not plumbing: the login brute-force throttle keys
# on the client IP derived from X-Forwarded-For, so any address listed here can
# forge that IP and evade the lockout. Narrow it to your proxy - e.g.
# 10.0.0.5/32 - rather than leaving the private-range default in place.
#
# Leave unset to accept the default below (all private + loopback ranges).
CALENDARSYNC_TRUSTED_PROXIES=192.168.0.0/16,172.16.0.0/12,169.254.0.0/16,fc00::/7,10.0.0.0/8,100.64.0.0/10,127.0.0.0/8,fe80::/10,::1/128

# Whether the session cookie is marked Secure. Defaults to true, which is
# correct whenever a TLS-terminating proxy is in front. Set false ONLY to test
# against http://host:8080 directly - a browser silently drops a Secure cookie
# over plain http, which looks like "login succeeds then bounces to /login".
# CALENDARSYNC_SECURE_COOKIE=true

# Optional: leave blank to disable that provider's "Connect" button until
# you register an OAuth app for it (see README).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT_ID=common

# Where the application logs. Exactly one destination is used, not a
# combination of them:
#   console  - stdout, i.e. `docker logs` (the default)
#   file     - rolling file on the /data volume, at CALENDARSYNC_LOG_PATH
#   elastic  - ECS JSON over TCP to the collector configured below
CALENDARSYNC_LOG_DESTINATION=console

# Only read when CALENDARSYNC_LOG_DESTINATION=elastic. This is a Logstash or
# Elastic Agent TCP input (json_lines codec) - NOT an Elasticsearch node; the
# app never writes to Elasticsearch directly. TLS uses the JVM trust store.
CALENDARSYNC_LOG_ELASTIC_HOST=localhost
CALENDARSYNC_LOG_ELASTIC_PORT=5044
CALENDARSYNC_LOG_ELASTIC_TLS=false
