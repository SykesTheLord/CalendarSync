# Environment for the native systemd unit - installed to
# /etc/calendarsync/calendarsync.env, mode 0600, owned by root.
#
# This is NOT the same file as the repository's .env, which configures the
# Docker Compose stack. A native install uses this one only.
#
# systemd parses it as KEY=value lines, not as a shell script: no `export`, no
# command substitution, and no variable expansion - a literal $ stays a $, and
# `KEY=$OTHER` is the four characters, not a reference. Quote only when the
# value contains whitespace.

# --- Required ------------------------------------------------------------

# Whole-database encryption key, and (derived separately from it) the key for
# the encrypted_credentials column. Generated by install-ubuntu.sh on first
# install with `openssl rand -base64 32`.
#
# CHANGING OR LOSING THIS MAKES AN EXISTING DATABASE UNREADABLE. There is no
# recovery path and no re-key migration; back it up somewhere other than this
# machine before it is the only copy.
CALCLEANER_DB_KEY=

# The externally-visible HTTPS URL, as the reverse proxy publishes it. Embedded
# in every /feed/{token}.ics link handed to a calendar client, so a wrong value
# here produces feeds that subscribers cannot reach. No default - the app
# refuses to start without it, deliberately.
CALENDARSYNC_BASE_URL=https://calendar.example.com

# Where the SQLite database lives. This override is NOT optional on a native
# install: the prod profile's built-in default is /data/calendarsync.db, which
# is the path inside the Docker image's volume. On a normal filesystem /data
# does not exist, and the unit's ProtectSystem=strict makes it read-only even
# if it did, so leaving this unset fails at startup with SQLITE_CANTOPEN.
CALENDARSYNC_DB_PATH=/var/lib/calendarsync/calendarsync.db

# --- Network -------------------------------------------------------------

# Which interface the app binds. Loopback by default, matching what
# docker-compose.yml achieves with its 127.0.0.1:8080:8080 port mapping - and
# the reason it has to be stated explicitly here is that a native install has
# no port mapping to do it. Spring's own default is every interface, so an
# unset value publishes an unencrypted login form on whatever addresses this
# host has, which on a VPS means the internet.
#
# Set it to the private address the reverse proxy connects to when the proxy
# runs on another machine. Never 0.0.0.0.
SERVER_ADDRESS=127.0.0.1

# Which source addresses may set X-Forwarded-For / X-Forwarded-Proto. The login
# brute-force lockout keys on the client IP this produces, so anything listed
# here can forge that IP and evade the lockout - narrow it to the proxy's own
# address (e.g. 10.0.0.5/32) rather than leaving the private-range default.
# Conversely, if the proxy is NOT listed, every request appears to come from it
# and one attacker locks out every user at once.
CALENDARSYNC_TRUSTED_PROXIES=192.168.0.0/16,172.16.0.0/12,169.254.0.0/16,fc00::/7,10.0.0.0/8,100.64.0.0/10,127.0.0.0/8,fe80::/10,::1/128

# Set false ONLY when testing against http://host:8080 with no TLS proxy in
# front - a browser silently drops a Secure cookie over plain http, which
# presents as "login succeeds, then every page bounces back to /login".
# CALENDARSYNC_SECURE_COOKIE=true

# --- Logging -------------------------------------------------------------

# console | file | elastic - exactly one, not a combination. "console" means
# journald here, i.e. `journalctl -u calendarsync`, which is the right default
# for a systemd service.
CALENDARSYNC_LOG_DESTINATION=console

# Only read when the destination is "file". Like CALENDARSYNC_DB_PATH, the
# built-in default (/data/logs/) is the container's path and is unwritable
# here, so it must be overridden rather than inherited.
CALENDARSYNC_LOG_PATH=/var/lib/calendarsync/logs/calendarsync.log

# Only read when the destination is "elastic". A Logstash or Elastic Agent TCP
# input with the json_lines codec - never an Elasticsearch node directly.
CALENDARSYNC_LOG_ELASTIC_HOST=localhost
CALENDARSYNC_LOG_ELASTIC_PORT=5044
CALENDARSYNC_LOG_ELASTIC_TLS=false

# --- OAuth providers (optional) ------------------------------------------
# Leave blank to drop that provider from the connection dropdown. CalDAV,
# iCloud and ICS-URL sources need none of this.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT_ID=common
